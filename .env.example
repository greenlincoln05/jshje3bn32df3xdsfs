# Copy to .env (gitignored) and fill in. Never commit real values.
#
# Kalshi keeps demo and production credentials separate: a demo key only works with KALSHI_ENV=demo.
# Public market data needs no credentials at all, so `btcbot discover` works with this file empty.

# demo (default, fake money) or prod
KALSHI_ENV=demo

# API key id shown once when you create a key in Account & security -> API Keys
KALSHI_KEY_ID=

# Path to the downloaded RSA private key file (keep it outside this repo).
# Windows: write the path UNQUOTED (C:\Users\me\keys\kalshi.key) or with forward slashes (C:/Users/me/keys/kalshi.key).
# Inside double quotes a sequence like \t in C:\temp\... becomes a TAB and the path silently breaks.
KALSHI_PRIVATE_KEY_PATH=
